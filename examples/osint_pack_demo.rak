// --- Markdown evidence report ---
let md = report_markdown({
    title: "Probe 2026-09-27",
    meta: { operator: "rak-demo", target: "10.0.0.5" },
    sections: {
        "Open ports": ["443/tcp https", "22/tcp ssh"],
        "YARA": ["mzbanner matched sample.bin at offset 0"],
    }
})
dump md[..30]            // "# Probe 2026-09-27" + newline...
