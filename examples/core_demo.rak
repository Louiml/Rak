// Rak 0.8 language core: `in`, destructuring `let`, slice indexing.
// Runs on both the interpreter (`rakc run`) and the VM (`rakc vm`).

// --- membership: `x in collection` ---
dump "ell" in "hello"             // true
dump "x" in "hello"               // false
dump 2 in [1, 2, 3]               // true
dump "a" in { a: 1 }              // true
dump 0x4D in b"MZ"                // true

// --- destructuring let ---
let (host, port) = ("10.0.0.5", 443)
let [first, second, rest] = [10, 20, 30]
let [x, [y, z]] = [1, [2, 3]]     // nested
dump host + ":" + port            // 10.0.0.5:443
dump first + rest                 // 40
dump x + y + z                    // 6
let mut (lo, hi) = (1, 2)
lo = hi                          // mut destructuring supports reassignment
dump lo

// --- slice indexing ---
let d = [10, 20, 30, 40, 50]
dump d[1..3]                      // [20, 30]
dump d[..2]                       // [10, 20]
dump d[-2..]                      // [40, 50]
dump d[-1]                        // 50 (negative single index)
dump "hello"[1..3]                // el (char-based)
let mut stack = [1, 2, 3]
stack[-1] = 99                    // replace the tail
dump stack                        // [1, 2, 99]