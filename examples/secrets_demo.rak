// Secrets API (#9): session + local resolution.
secret_set("RAK_TEST_TOKEN", "abc123")
dump secret_get("RAK_TEST_TOKEN")
secret_delete("RAK_TEST_TOKEN")
dump secret_get("RAK_TEST_TOKEN")   // nil

// dns_reverse on a localhost-mapped PTR is environment dependent, so just
// exercise the pure builders here.
dump dns_walk("example.com", ["www", "mail", "nonexistent-zz"])