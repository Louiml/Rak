// VPN: Out-of-band X25519 key exchange.
//
//   rakc run examples/VPN/keyexchange.rak   (interpreter)
//   rakc vm  examples/VPN/keyexchange.rak   (bytecode VM)
//
// Two parties (Alice and Bob) each generate an X25519 keypair. They exchange
// only their *public* keys over the untrusted link. Each combines their own
// secret with the peer's public key to derive the SAME shared secret, which
// then keys the tunnel's AEAD phase. This is forward secret: compromising a
// peer's long-term secret does not recover past sessions.
//
// Seed bytes are fixed here purely for a deterministic demo; in a real VPN use
// freshly random seeds for ephemeral handshake keys.

// Alice's keypair from a 32-byte seed -> (public, secret).
let alice = x25519_keypair(b"\x00\x01\x02\x03\x04\x05\x06\x07\x08\x09\x0a\x0b\x0c\x0d\x0e\x0f\x10\x11\x12\x13\x14\x15\x16\x17\x18\x19\x1a\x1b\x1c\x1d\x1e\x1f")
let a_pub = alice.0
let a_sec = alice.1

// Bob's keypair from a different seed.
let bob = x25519_keypair(b"\x20\x21\x22\x23\x24\x25\x26\x27\x28\x29\x2a\x2b\x2c\x2d\x2e\x2f\x30\x31\x32\x33\x34\x35\x36\x37\x38\x39\x3a\x3b\x3c\x3d\x3e\x3f")
let b_pub = bob.0
let b_sec = bob.1

dump fmt("alice public = 0x{}", hex_encode(a_pub))
dump fmt("bob   public = 0x{}", hex_encode(b_pub))

// Each party computes the shared secret from their own secret + the OTHER's public.
let shared_alice = x25519_shared(a_sec, b_pub)
let shared_bob   = x25519_shared(b_sec, a_pub)

dump fmt("alice shared = 0x{}", hex_encode(shared_alice))
dump fmt("bob   shared = 0x{}", hex_encode(shared_bob))

// Both must agree bit-for-bit.
dump fmt("shared secrets match: {}", hex_encode(shared_alice) == hex_encode(shared_bob))
dump fmt("shared secret length: {} bytes", len(shared_alice))

// A third party without either secret sees only the public keys and cannot
// derive the shared secret (the X25519 CDH assumption).
let eve = x25519_keypair(b"\x40\x41\x42\x43\x44\x45\x46\x47\x48\x49\x4a\x4b\x4c\x4d\x4e\x4f\x50\x51\x52\x53\x54\x55\x56\x57\x58\x59\x5a\x5b\x5c\x5d\x5e\x5f")
let eve_guess = x25519_shared(eve.1, a_pub)
dump fmt("eve (no secret) guesses: 0x{}", hex_encode(eve_guess))
dump fmt("eve fails: {}", hex_encode(eve_guess) == hex_encode(shared_alice))