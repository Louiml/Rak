// gui_demo.rak — a native desktop window built from Rak widgets (no HTML)
// Run with: rakc run examples/gui_demo.rak (build rakc with --features gui)
//
// Demonstrates the native GUI API:
//   gui_window, gui_add, gui_on_click, gui_callback,
//   gui_set_text, gui_get_text, gui_set_visible, gui_wait
//
// Widget kinds: "label", "button", "input", "checkbox", "select", "textarea".
// A "select" widget takes its options as a comma-separated text argument.
//
// Note on callbacks: `gui_callback` snapshots the environment at the point of
// the call, so a handler sees the variables that existed *before* it was
// registered, and its own mutations do not flow back into the running script.
// Keep handlers self-contained.

fn on_click() {
  print "clicked"
  return nil
}

gui_callback("on_click", on_click)

let win = gui_window("Rak GUI Demo", 420, 240)
dump f"Window opened with ID: {win}"

// gui_add(window, kind, text, x, y, w, h) -> widget id
let heading = gui_add(win, "label", "Hello from Rak!", 20, 20, 380, 28)
let name = gui_add(win, "input", "world", 20, 70, 240, 28)
let agree = gui_add(win, "checkbox", "I agree", 20, 120, 200, 24)
let button = gui_add(win, "button", "Click me", 20, 170, 140, 34)

// A select's text is its option list.
gui_add(win, "select", "Small, Medium, Large", 20, 210, 200, 28)

gui_on_click(button, "on_click")

gui_set_text(heading, "Native widgets, zero HTML")
gui_set_text(name, "Rak")

dump f"input reads: {gui_get_text(name)}"
dump f"checkbox reads: {gui_get_text(agree)}"

// gui_set_visible(widget, false) hides a widget without removing it.

gui_wait()
dump "All windows closed"