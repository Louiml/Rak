{
  "name": "rak",
  "displayName": "Rak",
  "description": "Rak language support: syntax highlighting, diagnostics, and DAP debugging",
  "version": "8.1.0",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "rak",
        "aliases": ["Rak", "rak"],
        "extensions": [".rak"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "rak",
        "scopeName": "source.rak",
        "path": "./syntaxes/rak.tmLanguage.json"
      }
    ],
    "debuggers": [
      {
        "type": "rak",
        "label": "Rak (rakc dap)",
        "runtime": "executable",
        "program": "rakc",
        "args": ["dap", "${file}"],
        "configurationAttributes": {
          "launch": {
            "required": ["program"],
            "properties": {
              "program": {
                "type": "string",
                "description": "Path to the .rak file to debug"
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "rak",
            "request": "launch",
            "name": "Rak: Debug current file",
            "program": "${file}"
          }
        ]
      }
    ]
  }
}