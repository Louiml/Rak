{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Rak",
  "scopeName": "source.rak",
  "patterns": [
    { "include": "#comments" },
    { "include": "#regex" },
    { "include": "#strings" },
    { "include": "#bytes" },
    { "include": "#chars" },
    { "include": "#macroinvoke" },
    { "include": "#macrovar" },
    { "include": "#keywords" },
    { "include": "#builtins" },
    { "include": "#types" },
    { "include": "#hex" },
    { "include": "#binary_octal" },
    { "include": "#numbers" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.double-slash.rak", "match": "//.*$" }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.interpolated.rak",
          "begin": "f\"",
          "end": "\"",
          "patterns": [
            { "name": "constant.character.escape.rak", "match": "\\\\." },
            {
              "name": "meta.interpolation.rak",
              "begin": "\\{",
              "end": "\\}",
              "patterns": [ { "include": "$self" } ]
            }
          ]
        },
        {
          "name": "string.quoted.double.rak",
          "begin": "\"",
          "end": "\"",
          "patterns": [ { "name": "constant.character.escape.rak", "match": "\\\\." } ]
        }
      ]
    },
    "bytes": {
      "patterns": [
        {
          "name": "string.quoted.other.rak",
          "begin": "b\"",
          "end": "\"",
          "patterns": [ { "name": "constant.character.escape.rak", "match": "\\\\." } ]
        }
      ]
    },
    "chars": {
      "patterns": [
        {
          "name": "constant.character.rak",
          "match": "'([^'\\\\]|\\\\x[0-9A-Fa-f]{2}|\\\\u\\{[0-9A-Fa-f]{1,6}\\}|\\\\.)'"
        }
      ]
    },
    "regex": {
      "patterns": [
        {
          "name": "string.regexp.rak",
          "begin": "(?x)(?<![A-Za-z0-9_\\)\\]\\}\\.'\"])(/)",
          "end": "(/)([a-z]*)",
          "patterns": [
            { "name": "constant.character.escape.rak", "match": "\\\\/|\\\\." },
            {
              "name": "constant.other.escape.rak",
              "begin": "\\[",
              "end": "\\]",
              "patterns": [ { "name": "constant.character.escape.rak", "match": "\\\\." } ]
            }
          ],
          "beginCaptures": { "1": { "name": "punctuation.definition.string.rak" } },
          "endCaptures": {
            "1": { "name": "punctuation.definition.string.rak" },
            "2": { "name": "keyword.other.rak" }
          }
        }
      ]
    },
    "macroinvoke": {
      "patterns": [
        {
          "name": "entity.name.function.macro.rak",
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\!"
        }
      ]
    },
    "macrovar": {
      "patterns": [
        { "name": "variable.other.macrovar.rak", "match": "\\$[A-Za-z_][A-Za-z0-9_]*" }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.rak",
          "match": "\\b(if|else|for|while|loop|break|continue|return|match|try|catch|raise|throw|spawn|await|async|as|type|from|import|evidence|defer|test|assert)\\b"
        },
        {
          "name": "keyword.other.rak",
          "match": "\\b(let|mut|fn|struct|enum|impl|trait|mod|pub|use|export|scan|fetch|dump|trace|macro|macro_rules|const|extern|binstruct|tunnel|rest|in|unsafe)\\b"
        },
        {
          "name": "constant.language.rak",
          "match": "\\b(true|false|nil|Some|None|Ok|Err)\\b"
        }
      ]
    },
    "builtins": {
      "comment": "Grouped by family rather than one flat alternation, so a new builtin is a one-line edit instead of a 2900-character line. Order matters only for overlapping names.",
      "patterns": [
        {
          "name": "support.function.rak",
          "match": "\\b(ffi_load|ffi_ptr|ffi_alloc|ffi_free|ffi_write|ffi_read|ffi_read_i32|ffi_cstr_to_string|ffi_string_to_cstr|ffi_call|mmap_open|mmap_slice|mmap_size|mmap_close|mmap_find|mmap_lines|mmap_lines_off)\\b"
        },
        {
          "name": "support.function.rak",
          "match": "\\b(net_raw_csum|net_raw_ipv4|net_raw_tcp|net_raw_udp|net_raw_tcp_syn|net_raw_send|net_raw_recv|net_raw_icmp|net_raw_icmp_ping|net_raw_icmp_echo_reply|net_raw_arp_request|net_raw_arp_reply|net_raw_arp_parse)\\b"
        },
        {
          "name": "support.function.rak",
          "match": "\\b(ct_eq|ct_eq_hex|ct_select|zeroize|secret_delete_all)\\b"
        },
        {
          "name": "support.function.rak",
          "match": "\\b(rsa_keypair|rsa_sign|rsa_verify|rsa_encrypt|rsa_decrypt|ecdsa_keypair|ecdsa_sign|ecdsa_verify|ed25519_keypair|ed25519_sign|ed25519_verify|x25519_keypair|x25519_shared|chacha20_encrypt|chacha20_decrypt|hmac_sha256|aes_gcm_encrypt|aes_gcm_decrypt|md5|sha1|sha256|xor|rot13|psk_derive|hkdf_derive)\\b"
        },
        {
          "name": "support.function.rak",
          "match": "\\b(dns_query|dns_build|dns_parse|dns_resolve|dns_reverse|dns_records|dns_walk|dns_lookup|reverse_dns|tls_parse_client_hello|tls_parse_cert_chain|pcap_open|pcap_next|whois_lookup|whois_parse|ct_subdomains|yara_scan|report_markdown)\\b"
        },
        {
          "name": "support.function.rak",
          "match": "\\b(net_listen|net_accept|net_connect|net_local_addr|tcp_read|tcp_read_line|tcp_write|tcp_close|tcp_probe|tcp_connect_async|tcp_stream|udp_bind|udp_send|udp_recv|udp_local_addr|http_get_async|http_server_start|http_server_poll|http_server_respond|http_server_stop|ws_connect|ws_handshake|ws_send|ws_recv|ws_close|scan_ports|scan_subdomains|fetch)\\b"
        },
        {
          "name": "support.function.rak",
          "match": "\\b(spawn|thread_join|channel|chan_send|chan_recv|await_all|select|timeout|task_group|async_sleep|async_yield)\\b"
        },
        {
          "name": "support.function.rak",
          "match": "\\b(tunnel_preshared_key|tunnel_frame|tunnel_unframe|tunnel_nonce|kdf_next)\\b"
        },
        {
          "name": "support.function.rak",
          "match": "\\b(file_read|file_write|file_append|file_exists|file_size|file_list|file_delete|file_mkdir|file_copy|file_rename|file_ext|file_basename|file_dirname)\\b"
        },
        {
          "name": "support.function.rak",
          "match": "\\b(secret_get|secret_set|secret_persist|secret_delete|secret_ls|process_spawn|process_wait|process_stdout|process_stderr|process_kill|log_level|log_init|log_info|log_warn|log_error|log_debug|gui_open|gui_update|gui_title|gui_close|gui_wait|gui_callback)\\b"
        },
        {
          "name": "support.function.rak",
          "match": "\\b(json_parse|json_stringify|json_get|json_path|json_keys|json_len|json_find_all|html_title|html_select|html_select_all|html_attr|html_links|html_images|html_scripts|html_forms|html_inputs|html_meta|html_count|html_headers)\\b"
        },
        {
          "name": "support.function.rak",
          "match": "\\b(time_now|time_now_millis|time_fmt|time_parse|time_parts|time_add|time_diff|date_today|rand_seed|rand_int|rand_float|rand_bytes|rand_hex|rand_choice|rand_shuffle)\\b"
        },
        {
          "name": "support.function.rak",
          "match": "\\b(csv_parse|csv_stringify|yaml_parse|parse_csv_line|parse_jsonl_line|gzip|gzip_compress|gunzip|gzip_decompress|deflate|inflate|zip_archive|zip_list|zip_extract|zip_read|zip_write)\\b"
        },
        {
          "name": "support.function.rak",
          "match": "\\b(stream_from_array|stream_map|stream_next|stream_csv|stream_jsonl|read_lines|filter|take|collect|zip|enumerate|fold|reduce|any|all|flat_map|take_while|skip)\\b"
        },
        {
          "name": "support.function.rak",
          "match": "\\b(report|cite|provenance|strip_evidence|evidence_from)\\b"
        },
        {
          "name": "support.function.rak",
          "match": "\\b(hex_encode|hex_decode|base64_encode|base64_decode|url_encode|url_decode|to_hex|from_hex|regex_new|regex_match|regex_is_match|regex_find|regex_find_all|regex_replace)\\b"
        },
        {
          "name": "support.function.rak",
          "match": "\\b(len|string|bytes|int|float|split|join|contains|push|keys|has|get|values|sum|max|min|abs|sqrt|pow|clamp|replace|find|starts_with|ends_with|slice|repeat|trim|trim_start|trim_end|reverse|sort|upper|lower|substr|ord|chr|read|write|array|map|print|dbg|exit|sleep|now_ms|args|argv|env_get|env_set|fmt|dump|trace|line|error|stdin_read_line|stdin_read_all|eprint|parse_args)\\b"
        }
      ]
    },    "types": {
      "patterns": [
        {
          "name": "storage.type.rak",
          "match": "\\b(i8|i16|i32|i64|u8|u16|u32|u64|f32|f64|hex8|hex16|hex32|hex64|int|string|char|bytes|bool|void|Option|Result)\\b"
        }
      ]
    },
    "hex": {
      "patterns": [
        { "name": "constant.numeric.hex.rak", "match": "\\b0[xX][0-9A-Fa-f]+\\b" }
      ]
    },
    "binary_octal": {
      "patterns": [
        { "name": "constant.numeric.rak", "match": "\\b0[bB][01_]+\\b" },
        { "name": "constant.numeric.rak", "match": "\\b0[oO][0-7_]+\\b" }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.rak",
          "match": "\\b[0-9]+(\\.[0-9]+)?([eE][+-]?[0-9]+)?(i8|i16|i32|i64|u8|u16|u32|u64|f32|f64)?\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.rak",
          "match": "(\\|>|->|=>|::|\\.\\.|==|!=|<=|>=|<<|>>|&&|\\|\\||\\+=|-=|\\*=|/=|%=|\\+|-|\\*|/|%|&|\\||\\^|!|~|<|>|=|\\$)"
        }
      ]
    }
  }
}
