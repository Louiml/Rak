{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Rak",
  "scopeName": "source.rak",
  "patterns": [
    { "include": "#comments" },
    { "include": "#regex" },
    { "include": "#strings" },
    { "include": "#bytes" },
    { "include": "#chars" },
    { "include": "#macroinvoke" },
    { "include": "#macrovar" },
    { "include": "#keywords" },
    { "include": "#builtins" },
    { "include": "#types" },
    { "include": "#hex" },
    { "include": "#numbers" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.double-slash.rak", "match": "//.*$" }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.interpolated.rak",
          "begin": "f\"",
          "end": "\"",
          "patterns": [
            { "name": "constant.character.escape.rak", "match": "\\\\." },
            {
              "name": "meta.interpolation.rak",
              "begin": "\\{",
              "end": "\\}",
              "patterns": [ { "include": "$self" } ]
            }
          ]
        },
        {
          "name": "string.quoted.double.rak",
          "begin": "\"",
          "end": "\"",
          "patterns": [ { "name": "constant.character.escape.rak", "match": "\\\\." } ]
        }
      ]
    },
    "bytes": {
      "patterns": [
        {
          "name": "string.quoted.other.rak",
          "begin": "b\"",
          "end": "\"",
          "patterns": [ { "name": "constant.character.escape.rak", "match": "\\\\." } ]
        }
      ]
    },
    "chars": {
      "patterns": [
        {
          "name": "constant.character.rak",
          "match": "'([^'\\\\]|\\\\x[0-9A-Fa-f]{2}|\\\\.)'"
        }
      ]
    },
    "regex": {
      "patterns": [
        {
          "name": "string.regexp.rak",
          "begin": "(?x)(?<![A-Za-z0-9_\\)\\]\\}\\.'\"])(/)",
          "end": "(/)([a-z]*)",
          "patterns": [
            { "name": "constant.character.escape.rak", "match": "\\\\/|\\\\." },
            {
              "name": "constant.other.escape.rak",
              "begin": "\\[",
              "end": "\\]",
              "patterns": [ { "name": "constant.character.escape.rak", "match": "\\\\." } ]
            }
          ],
          "beginCaptures": { "1": { "name": "punctuation.definition.string.rak" } },
          "endCaptures": {
            "1": { "name": "punctuation.definition.string.rak" },
            "2": { "name": "keyword.other.rak" }
          }
        }
      ]
    },
    "macroinvoke": {
      "patterns": [
        {
          "name": "entity.name.function.macro.rak",
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\!"
        }
      ]
    },
    "macrovar": {
      "patterns": [
        { "name": "variable.other.macrovar.rak", "match": "\\$[A-Za-z_][A-Za-z0-9_]*" }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.rak",
          "match": "\\b(if|else|for|while|loop|break|continue|return|match|try|catch|raise|throw|spawn|await|async|as|type|from|import|evidence)\\b"
        },
        {
          "name": "keyword.other.rak",
          "match": "\\b(let|mut|fn|struct|enum|impl|trait|mod|pub|use|export|scan|fetch|dump|trace|macro|macro_rules|const|extern|binstruct|tunnel|rest|in)\\b"
        },
        {
          "name": "constant.language.rak",
          "match": "\\b(true|false|nil|Some|None|Ok|Err)\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.rak",
          "match": "\\b(ffi_load|ffi_ptr|ffi_alloc|ffi_free|ffi_write|ffi_read|ffi_read_i32|ffi_cstr_to_string|ffi_string_to_cstr|ffi_call|mmap_open|mmap_slice|mmap_size|mmap_close|mmap_find|mmap_lines|mmap_lines_off|net_raw_csum|net_raw_ipv4|net_raw_tcp|net_raw_udp|net_raw_tcp_syn|net_raw_send|net_raw_recv|dns_query|dns_build|dns_parse|dns_resolve|dns_reverse|dns_records|dns_walk|tls_parse_client_hello|tls_parse_cert_chain|pcap_open|pcap_next|http_get_async|tcp_probe|tcp_connect_async|net_listen|net_accept|net_connect|net_local_addr|tcp_read|tcp_read_line|tcp_write|tcp_close|thread_join|channel|chan_send|chan_recv|md5|sha1|sha256|hmac_sha256|aes_gcm_encrypt|aes_gcm_decrypt|ed25519_keypair|ed25519_sign|ed25519_verify|xor|rot13|hex_encode|hex_decode|base64_encode|base64_decode|url_encode|url_decode|json_parse|json_stringify|json_get|json_path|json_keys|json_len|json_find_all|regex_new|regex_match|regex_is_match|regex_find|regex_find_all|regex_replace|len|string|bytes|int|float|split|join|contains|to_hex|from_hex|push|keys|has|get|values|sum|max|min|abs|sqrt|pow|clamp|replace|find|starts_with|ends_with|slice|repeat|trim_start|trim_end|sort|upper|lower|substr|ord|chr|read|write|array|map|print|dbg|exit|sleep|now_ms|args|argv|env_get|env_set|fmt|dump|trace|spawn|file_read|file_write|file_append|file_exists|file_size|file_list|file_delete|file_mkdir|file_copy|file_rename|file_ext|file_basename|file_dirname|html_title|html_select|html_select_all|html_attr|html_links|html_images|html_scripts|html_forms|html_inputs|html_meta|html_count|html_headers|scan_ports|scan_subdomains|dns_lookup|reverse_dns|secret_get|secret_set|secret_persist|secret_delete|secret_ls|log_level|log_init|log_info|log_warn|log_error|log_debug|process_spawn|process_wait|process_stdout|process_stderr|process_kill|http_server_start|http_server_poll|http_server_respond|http_server_stop|ws_connect|ws_handshake|ws_send|ws_recv|ws_close|gui_open|gui_update|gui_title|gui_close|gui_wait|gui_callback|report|cite|strip_evidence|provenance|x25519_keypair|x25519_shared|chacha20_encrypt|chacha20_decrypt|tunnel_preshared_key|kdf_next|tunnel_frame|tunnel_unframe|tunnel_nonce|udp_bind|udp_send|udp_recv|udp_local_addr|error|err_message|err_kind|err_line|err_col|err_file|err_cause|err_context|err_with_context|await_all|select|timeout|task_group|async_sleep|async_yield|stream_from_array|stream_map|stream_next|filter|take|collect|read_lines|tcp_stream|stream_csv|stream_jsonl|parse_csv_line|gzip|gunzip|deflate|inflate|zip_archive|zip_list|zip_extract|stdin_read_line|stdin_read_all|eprint|parse_args)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.rak",
          "match": "\\b(i8|i16|i32|i64|u8|u16|u32|u64|f32|f64|hex8|hex16|hex32|hex64|int|string|bytes|bool|void|Option|Result)\\b"
        }
      ]
    },
    "hex": {
      "patterns": [
        { "name": "constant.numeric.hex.rak", "match": "\\b0[xX][0-9A-Fa-f]+\\b" }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.rak",
          "match": "\\b[0-9]+(\\.[0-9]+)?([eE][+-]?[0-9]+)?(i8|i16|i32|i64|u8|u16|u32|u64|f32|f64)?\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.rak",
          "match": "(\\|>|->|=>|::|\\.\\.|==|!=|<=|>=|<<|>>|&&|\\|\\||\\+=|-=|\\*=|/=|%=|\\+|-|\\*|/|%|&|\\||\\^|!|~|<|>|=|\\$)"
        }
      ]
    }
  }
}
